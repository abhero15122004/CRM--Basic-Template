# ===================================================================
# Sample Environment Variables for Customer Relationship Manager (CRM)
# Copy this file to .env or export these variables in your environment.
# ===================================================================

# MySQL Database Connection URL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/crm_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# Database Credentials
SPRING_DATASOURCE_USERNAME=crm_user
SPRING_DATASOURCE_PASSWORD=your_password

# Application Server Port (defaults to 8080)
SERVER_PORT=8080

# Hibernate DDL Auto Strategy
# Note: 'update' is for local development only. Production must use 'validate' or 'none' with migrations.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# SQL Logging (set to true for development debugging)
SPRING_JPA_SHOW_SQL=false
